{
  "name": "drawing-axi",
  "version": "0.2.0",
  "description": "A command-line tool that lets AI agents read CAD drawings saved as PDF: layers, labels, scale, pipe runs and counts",
  "license": "MIT",
  "type": "module",
  "bin": {
    "drawing-axi": "dist/bin/drawing-axi.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comisai/drawing-axi.git"
  },
  "homepage": "https://github.com/comisai/drawing-axi#readme",
  "bugs": {
    "url": "https://github.com/comisai/drawing-axi/issues"
  },
  "keywords": [
    "cad",
    "pdf",
    "drawing",
    "quantity-takeoff",
    "construction",
    "cli",
    "ai-agents",
    "axi",
    "toon"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/chmod-bin.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "node --test \"test/unit/**/*.test.ts\" \"test/contract/**/*.test.ts\" \"test/axi/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm test",
    "live": "node test/live/drawing-live.mjs",
    "check:package": "node scripts/check-package.mjs",
    "test:dist": "DRAWING_AXI_BIN=dist node --test \"test/contract/**/*.test.ts\" \"test/axi/**/*.test.ts\""
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@toon-format/toon": "4.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
